# ============================================================
# ANEXYpro — variables de entorno
# Copiar a .env y completar con valores reales. Nunca commitear .env.
# ============================================================

# ------------------------------------------------------------
# Base de datos — DOS conexiones, y la diferencia importa
#
# DATABASE_URL es el rol de la APLICACIÓN. Tiene que ser un rol SIN
# SUPERUSER y SIN BYPASSRLS, y que NO sea dueño de las tablas: si lo
# fuera, Postgres no le aplicaría Row-Level Security y el aislamiento
# entre empresas administradoras dejaría de existir. Crear el rol con
# `scripts/crear-rol-app.sql`.
#
# DIRECT_URL es el DUEÑO de las tablas. Solo lo usan las migraciones
# (`prisma migrate`) y los archivos de `prisma/sql/`. La aplicación
# nunca se conecta con él.
#
# Después de crear la base hay que aplicar, en orden y con el dueño:
#   npx tsx scripts/aplicar-sql.ts prisma/sql/01_views_functions_triggers.sql
#   npx tsx scripts/aplicar-sql.ts prisma/sql/02_row_level_security.sql
#   npx tsx scripts/aplicar-sql.ts prisma/sql/03_rls_endurecido.sql
#   npx tsx scripts/aplicar-sql.ts prisma/sql/04_master_unico.sql
# ------------------------------------------------------------
DATABASE_URL="postgresql://anexypro_app:password@localhost:5432/anexypro?schema=public"
DIRECT_URL="postgresql://anexypro:password@localhost:5432/anexypro?schema=public"

# Auth.js (NextAuth v5) — generar con: openssl rand -base64 32
AUTH_SECRET="reemplazar-con-un-valor-aleatorio-largo"
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------
# Correo de la administración (Resend) — REQUERIDO para "Crear
# usuarios por condominio": la contraseña temporal del residente viaja
# únicamente por correo (usuario + contraseña + enlace de la app).
#
# Pasos:
#   1. Crear cuenta en https://resend.com y generar una API key.
#   2. Resend → Domains → Add Domain → anexypro.com, y agregar en el
#      DNS del dominio los registros que Resend indica:
#        - SPF   (TXT)  — autoriza a Resend a enviar por el dominio
#        - DKIM  (TXT)  — firma criptográfica de cada correo
#      más un registro DMARC (TXT en _dmarc.anexypro.com, p. ej.
#      "v=DMARC1; p=quarantine; adkim=s; aspf=s").
#      SIN esta verificación los correos salen de un dominio compartido
#      y los filtros de spam los castigan — con SPF+DKIM+DMARC alineados
#      llegan a la bandeja de entrada como cualquier correo corporativo.
#   3. EMAIL_FROM debe usar ese dominio verificado.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="ANEXYpro <notificaciones@anexypro.com>"

# Enlace de acceso que va en los correos de bienvenida.
APP_URL="https://app.anexypro.com"

# Árbitro Legal IA (Ecosistema Condómino) — usa la API de Claude para
# responder consultas de residentes, fundamentado EXCLUSIVAMENTE en el
# texto real del reglamento que la administración carga en Gestión
# Documental (documents.bodyText). Sin esta clave, el asistente
# responde con honestidad que no está conectado, en vez de fabricar
# una respuesta legal.
ANTHROPIC_API_KEY=""

# --- Programador de tareas (fase 0 de Finanzas) ---
# Secreto que autoriza al programador externo a llamar /api/cron.
# Si se deja vacío, SOLO un administrador con sesión puede disparar los
# procesos: el endpoint nunca queda abierto al público.
# Genera uno con: openssl rand -hex 32
CRON_SECRET=

# En producción, programa una llamada diaria (por ejemplo a las 6:00):
#   curl -H "Authorization: Bearer $CRON_SECRET" https://app.anexypro.com/api/cron

# --- Repositorio de documentos ---
# El proveedor activo se elige en el panel master (Almacenamiento).
# Por omisión es el servidor de ANEXYpro (carpeta storage/, privada).
#
# Para usar Google Drive: cuenta de servicio de Google Cloud con la API
# de Drive habilitada, y la carpeta raíz compartida con ese correo.
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
# Muy recomendado: sin unidad compartida los archivos cuentan contra la
# cuota de la cuenta de servicio, que es pequeña y no se puede ampliar.
GOOGLE_DRIVE_SHARED_DRIVE_ID=
