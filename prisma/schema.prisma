// ============================================================
// Gestión de Tareas (tablero interno de la administradora)
// ============================================================
enum AdminTaskPriority {
  baja
  media
  alta
}

enum AdminTaskStatus {
  pendiente
  en_progreso
  completada
}

model AdminTask {
  id            String            @id @default(uuid())
  companyId     String            @map("company_id")
  title         String
  category      String?
  subcategory   String?
  assignedToId  String?           @map("assigned_to")
  // Condominio al que pertenece la tarea. Lo elige la administración
  // al asignarla; el supervisor solo ve las de sus condominios.
  condominiumId String?           @map("condominium_id")
  priority      AdminTaskPriority @default(media)
  dueDate       DateTime?         @map("due_date") @db.Date
  // Alarma configurable (fecha y hora exactas). El aviso en la fecha
  // de vencimiento es obligatorio y NO depende de este campo.
  alarmAt       DateTime?         @map("alarm_at")
  notes         String?
  status        AdminTaskStatus   @default(pendiente)
  createdById   String?           @map("created_by")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  assignedTo  User?                    @relation("TaskAssignee", fields: [assignedToId], references: [id])
  condominium Condominium?             @relation(fields: [condominiumId], references: [id])
  checklist   AdminTaskChecklistItem[]
  attachments AdminTaskAttachment[]

  @@index([companyId, status])
  @@index([companyId, dueDate])
  @@map("admin_tasks")
}

model AdminTaskChecklistItem {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  title     String
  done      Boolean  @default(false)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  task AdminTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("admin_task_checklist")
}

model AdminTaskAttachment {
  id         String   @id @default(uuid())
  taskId     String   @map("task_id")
  fileName   String   @map("file_name")
  fileUrl    String   @map("file_url")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  task AdminTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("admin_task_attachments")
}

// Supervisores asignados a un condominio (máximo 5 — se valida en la
// capa de servicio; ver assignSupervisor en condominiums.ts).
model CondominiumSupervisor {
  id            String   @id @default(uuid())
  condominiumId String   @map("condominium_id")
  userId        String   @map("user_id")
  createdAt     DateTime @default(now()) @map("created_at")

  condominium Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([condominiumId, userId])
  // `listCondominiumsForSession` busca por userId y corre en casi todas
  // las pantallas del panel. El índice único de arriba no sirve para
  // eso: userId no es su primera columna.
  @@index([userId])
  @@map("condominium_supervisors")
}

// ============================================================
// Emisión de documentos a solicitud del condómino
// (Certificación de cuotas al día · Estado de cuenta)
// ============================================================
enum DocRequestType {
  certificacion_cuotas_al_dia
  estado_cuenta
}

enum DocRequestStatus {
  solicitada
  aprobada
  rechazada
}

model DocumentRequest {
  id            String           @id @default(uuid())
  condominiumId String           @map("condominium_id")
  propertyId    String           @map("property_id")
  personId      String           @map("person_id")
  docType       DocRequestType   @map("doc_type")
  status        DocRequestStatus @default(solicitada)
  requestedAt   DateTime         @default(now()) @map("requested_at")
  dueBy         DateTime         @map("due_by") // 2 días hábiles desde la solicitud
  note          String? // nota del solicitante
  bodyText      String?          @map("body_text") // cuerpo del documento, editable por la administración
  decidedById   String?          @map("decided_by")
  decidedByName String?          @map("decided_by_name")
  decidedAt     DateTime?        @map("decided_at")
  rejectReason  String?          @map("reject_reason")
  // Fotografía financiera al momento de emitir: el documento emitido
  // NO cambia aunque después se registren cargos o pagos nuevos.
  issuedBalance Decimal?         @map("issued_balance") @db.Decimal(14, 2)
  issuedCharged Decimal?         @map("issued_charged") @db.Decimal(14, 2)
  issuedPaid    Decimal?         @map("issued_paid") @db.Decimal(14, 2)
  issuedCurrent Boolean?         @map("issued_current") // true = al día

  condominium Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  property    Property    @relation(fields: [propertyId], references: [id])
  person      Person      @relation(fields: [personId], references: [id])

  @@index([condominiumId, status])
  @@index([propertyId, requestedAt(sort: Desc)])
  @@map("document_requests")
}

// Diseño y contenido por condominio y tipo de documento.
model DocumentTemplate {
  id                     String         @id @default(uuid())
  condominiumId          String         @map("condominium_id")
  docType                DocRequestType @map("doc_type")
  logoUrl                String?        @map("logo_url")
  primaryColor           String         @default("#3B6EF5") @map("primary_color")
  headerText             String?        @map("header_text")
  footerText             String?        @map("footer_text")
  adminName              String?        @map("admin_name") // administradora asignada
  adminDetails           String?        @map("admin_details") // cédula jurídica, teléfono, correo
  bodyTemplate           String?        @map("body_template") // cuerpo por defecto (admite variables)
  signerName             String?        @map("signer_name")
  signerTitle            String?        @map("signer_title")
  /// Imagen de la firma escaneada, para que quede plasmada sobre la
  /// línea de firma del documento. Referencia del repositorio privado.
  signatureUrl           String?        @map("signature_url")
  // La certificación de cuotas al día EXIGE estar al día; el estado
  // de cuenta se emite siempre (muestra al día o en atraso).
  requiresCurrentAccount Boolean        @default(true) @map("requires_current_account")

  condominium Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)

  @@unique([condominiumId, docType])
  @@map("document_templates")
}

// ============================================================
// Directorio de proveedores para trabajos varios
// Base de datos de la PLATAFORMA (la administra el usuario master),
// visible para los residentes de todos los condominios.
// ============================================================
model ServiceProvider {
  id          String   @id @default(uuid())
  category    String // tipo de proveedor (ver SERVICE_CATEGORIES)
  name        String
  description String?
  // Accesorios / productos concretos que vende, separados por coma.
  // Alimentan la búsqueda específica por accesorio del residente.
  accessories String?
  phone       String
  whatsapp    String?
  email       String?
  website     String?
  logoUrl     String?  @map("logo_url")
  visible     Boolean  @default(true) // ocultar sin eliminar
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([category, visible])
  @@map("service_providers")
}

// ============================================================
// Caja chica — control de gastos operativos del supervisor
// ============================================================
// El saldo NO se guarda: se deriva de sumar asignaciones y restar
// gastos. Así nunca queda un saldo desincronizado de sus movimientos.

// Monto que la administración pone a disposición del supervisor.
// Cada reposición es una asignación nueva, no un ajuste del monto
// anterior, para que el informe conserve la trazabilidad.
model PettyCashAllocation {
  id            String   @id @default(uuid())
  companyId     String   @map("company_id")
  condominiumId String   @map("condominium_id")
  amount        Decimal  @db.Decimal(12, 2)
  allocatedOn   DateTime @map("allocated_on") @db.Date
  note          String?
  createdById   String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  condominium Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  createdBy   User?       @relation("PettyCashAllocatedBy", fields: [createdById], references: [id])

  @@index([companyId, condominiumId])
  @@map("petty_cash_allocations")
}

// Gasto registrado por el supervisor, con su factura de respaldo.
model PettyCashExpense {
  id            String   @id @default(uuid())
  companyId     String   @map("company_id")
  condominiumId String   @map("condominium_id")
  spentOn       DateTime @map("spent_on") @db.Date
  detail        String
  amount        Decimal  @db.Decimal(12, 2)
  invoiceUrl    String?  @map("invoice_url")
  invoiceName   String?  @map("invoice_name")
  createdById   String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  condominium Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  createdBy   User?       @relation("PettyCashSpentBy", fields: [createdById], references: [id])

  @@index([companyId, condominiumId, spentOn])
  @@map("petty_cash_expenses")
}

// ============================================================
// FASE 0 — Fundaciones financieras
// ============================================================

// Bitácora del programador de tareas. Es lo que hace que un job sea
// idempotente: antes de ejecutar se consulta si esa clave ya corrió.
model JobRun {
  id        String    @id @default(uuid())
  jobName   String    @map("job_name")
  // Clave lógica de la corrida (p. ej. "interes:2026-07-26"). Única:
  // si el programador dispara dos veces el mismo día, la segunda no
  // hace nada.
  runKey    String    @map("run_key")
  status    JobStatus @default(corriendo)
  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")
  // Resumen legible de lo que hizo, para poder auditarlo sin leer logs.
  summary   String?
  error     String?

  @@unique([jobName, runKey])
  @@index([jobName, startedAt(sort: Desc)])
  @@map("job_runs")
}

enum JobStatus {
  corriendo
  ok
  error
}

// Cierre contable: un período cerrado no admite asientos nuevos.
model AccountingPeriod {
  id            String       @id @default(uuid())
  companyId     String       @map("company_id")
  condominiumId String       @map("condominium_id")
  period        String // 'YYYY-MM'
  status        PeriodStatus @default(abierto)
  closedById    String?      @map("closed_by")
  closedAt      DateTime?    @map("closed_at")
  reopenReason  String?      @map("reopen_reason")
  // Saldos congelados al cierre, para comparativos históricos que no
  // cambien aunque después se corrija algo.
  snapshot      Json?

  condominium Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  closedBy    User?       @relation("PeriodClosedBy", fields: [closedById], references: [id])

  @@unique([condominiumId, period])
  @@index([companyId, condominiumId])
  @@map("accounting_periods")
}

enum PeriodStatus {
  abierto
  cerrado
}

// Cuenta bancaria del condominio. El saldo NO se guarda: se deriva de
// openingBalance más los movimientos contabilizados.
model BankAccount {
  id             String   @id @default(uuid())
  companyId      String   @map("company_id")
  condominiumId  String   @map("condominium_id")
  name           String
  bankName       String   @map("bank_name")
  accountNumber  String   @map("account_number")
  iban           String?
  currency       String   @default("CRC")
  // Cuenta contable espejo del plan de cuentas (1002, 1003…).
  accountCode    String   @map("account_code")
  openingBalance Decimal  @default(0) @map("opening_balance") @db.Decimal(14, 2)
  openingDate    DateTime @map("opening_date") @db.Date
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  condominium      Condominium       @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  bankTransactions BankTransaction[]
  payments         ExpensePayment[]

  @@index([companyId, condominiumId])
  @@map("bank_accounts")
}

// ============================================================
// FASE 1 — Egresos
// ============================================================

// Proveedor a nivel EMPRESA: se reutiliza entre condominios y guarda
// los datos tributarios que el Provider por condominio no tenía.
model Supplier {
  id                 String   @id @default(uuid())
  companyId          String   @map("company_id")
  legalName          String   @map("legal_name")
  tradeName          String?  @map("trade_name")
  taxId              String?  @map("tax_id")
  email              String?
  phone              String?
  bankAccount        String?  @map("bank_account")
  // Lo que el sistema APRENDE: la cuenta y categoría que más usa este
  // proveedor. Es lo que permite registrar un gasto sin elegirlas.
  defaultAccountCode String?  @map("default_account_code")
  defaultCategory    String?  @map("default_category")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expenses          Expense[]
  recurringExpenses RecurringExpense[]
  contracts         Contract[]

  @@index([companyId])
  @@map("suppliers")
}

enum ExpenseCategory {
  mantenimiento
  seguridad
  servicios // agua, luz, internet
  administracion
  jardineria
  limpieza
  seguros
  honorarios
  impuestos
  proyectos
  otro
}

enum ExpenseStatus {
  borrador
  por_aprobar
  aprobado
  pagado
  anulado
}

model Expense {
  id            String          @id @default(uuid())
  companyId     String          @map("company_id")
  condominiumId String          @map("condominium_id")
  supplierId    String?         @map("supplier_id")
  // Consecutivo legible por condominio.
  expenseNumber Int             @map("expense_number")
  category      ExpenseCategory
  // Cuenta de gasto del plan de cuentas. La deduce el sistema; el
  // administrador nunca tiene que escribirla.
  accountCode   String          @map("account_code")
  description   String
  invoiceNumber String?         @map("invoice_number")
  issueDate     DateTime        @map("issue_date") @db.Date
  dueDate       DateTime?       @map("due_date") @db.Date
  subtotal      Decimal         @db.Decimal(14, 2)
  taxAmount     Decimal         @default(0) @map("tax_amount") @db.Decimal(14, 2)
  total         Decimal         @db.Decimal(14, 2)
  currency      String          @default("CRC")
  status        ExpenseStatus   @default(borrador)
  documentUrl   String?         @map("document_url")
  documentName  String?         @map("document_name")
  // Si nació de un gasto recurrente, de cuál.
  recurringId   String?         @map("recurring_id")
  // Proyecto al que se imputa este gasto, si es de uno. Es lo que
  // alimenta la ejecución del kanban de Proyectos: el módulo para
  // anotar gastos de proyecto se retiró cuando ese trabajo pasó a
  // Finanzas, y desde entonces la tarjeta mostraba "0 de X" para
  // siempre. Opcional a propósito — la mayoría de los gastos son de
  // operación, no de proyecto.
  projectId     String?         @map("project_id")
  notes         String?
  approvedById  String?         @map("approved_by")
  approvedAt    DateTime?       @map("approved_at")
  voidedAt      DateTime?       @map("voided_at")
  voidReason    String?         @map("void_reason")
  createdById   String?         @map("created_by")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  condominium Condominium       @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  supplier    Supplier?         @relation(fields: [supplierId], references: [id])
  recurring   RecurringExpense? @relation(fields: [recurringId], references: [id])
  project     Project?          @relation(fields: [projectId], references: [id])
  createdBy   User?             @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  approvedBy  User?             @relation("ExpenseApprovedBy", fields: [approvedById], references: [id])
  payments    ExpensePayment[]

  @@unique([condominiumId, expenseNumber])
  @@index([companyId, condominiumId, issueDate(sort: Desc)])
  @@index([condominiumId, status])
  @@index([projectId])
  @@map("expenses")
}

// Un gasto admite pagos parciales; el saldo por pagar se deriva.
model ExpensePayment {
  id            String        @id @default(uuid())
  companyId     String        @map("company_id")
  expenseId     String        @map("expense_id")
  bankAccountId String?       @map("bank_account_id")
  amount        Decimal       @db.Decimal(14, 2)
  paymentDate   DateTime      @map("payment_date") @db.Date
  method        PaymentMethod
  reference     String?
  receiptUrl    String?       @map("receipt_url")
  createdById   String?       @map("created_by")
  createdAt     DateTime      @default(now()) @map("created_at")

  expense     Expense      @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id])

  @@index([expenseId])
  @@map("expense_payments")
}

// ============================================================
// FASE 2 — Gastos recurrentes y contratos
// ============================================================

enum RecurringFrequency {
  mensual
  bimensual
  trimestral
  semestral
  anual
}

// Gasto que se repite: salarios, polizas, servicios, honorarios.
// Es el grueso del gasto de un condominio y hasta ahora habia que
// digitarlo a mano todos los meses.
//
// El proceso automatico lo crea en BORRADOR unos dias antes del
// vencimiento — nunca lo aprueba solo: el monto puede variar y alguien
// tiene que verlo.
model RecurringExpense {
  id            String             @id @default(uuid())
  companyId     String             @map("company_id")
  condominiumId String             @map("condominium_id")
  supplierId    String?            @map("supplier_id")
  description   String
  category      ExpenseCategory
  // 0 = monto variable: el gasto se crea sin monto y se completa al revisarlo.
  amount        Decimal            @default(0) @db.Decimal(14, 2)
  frequency     RecurringFrequency @default(mensual)
  dayOfMonth    Int                @default(1) @map("day_of_month")
  // Dias de antelacion con que se crea el borrador.
  leadDays      Int                @default(5) @map("lead_days")
  startDate     DateTime           @map("start_date") @db.Date
  endDate       DateTime?          @map("end_date") @db.Date
  isActive      Boolean            @default(true) @map("is_active")
  lastGenerated DateTime?          @map("last_generated") @db.Date
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  condominium Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  supplier    Supplier?   @relation(fields: [supplierId], references: [id])
  expenses    Expense[]
  contract    Contract?

  @@index([companyId, condominiumId])
  @@map("recurring_expenses")
}

enum ContractStatus {
  vigente
  por_vencer
  vencido
  cancelado
}

// Contrato con un proveedor. Avisa antes de vencer.
model Contract {
  id                 String         @id @default(uuid())
  companyId          String         @map("company_id")
  condominiumId      String         @map("condominium_id")
  supplierId         String         @map("supplier_id")
  title              String
  serviceType        String         @map("service_type")
  startDate          DateTime       @map("start_date") @db.Date
  endDate            DateTime       @map("end_date") @db.Date
  monthlyAmount      Decimal?       @map("monthly_amount") @db.Decimal(14, 2)
  autoRenew          Boolean        @default(false) @map("auto_renew")
  // Con cuantos dias de antelacion hay que avisar del vencimiento.
  noticeDays         Int            @default(30) @map("notice_days")
  documentUrl        String?        @map("document_url")
  documentName       String?        @map("document_name")
  notes              String?
  status             ContractStatus @default(vigente)
  recurringExpenseId String?        @unique @map("recurring_expense_id")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  condominium      Condominium       @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  supplier         Supplier          @relation(fields: [supplierId], references: [id])
  recurringExpense RecurringExpense? @relation(fields: [recurringExpenseId], references: [id])

  @@index([companyId, condominiumId])
  @@index([condominiumId, endDate])
  @@map("contracts")
}

// ============================================================
// FASE 3 — Bancos y conciliacion
// ============================================================

enum BankTxStatus {
  sin_conciliar
  propuesto
  conciliado
  ignorado
}

// Movimiento del estado de cuenta bancario.
//
// `fingerprint` es lo que hace segura la reimportacion: si el
// administrador vuelve a subir el mismo archivo (o uno que se
// traslapa), los movimientos repetidos no se duplican.
model BankTransaction {
  id              String       @id @default(uuid())
  companyId       String       @map("company_id")
  bankAccountId   String       @map("bank_account_id")
  txDate          DateTime     @map("tx_date") @db.Date
  // Texto literal del banco, sin editar: es la senal que alimenta el
  // aprendizaje del motor de conciliacion.
  description     String
  reference       String?
  // Positivo entra, negativo sale.
  amount          Decimal      @db.Decimal(14, 2)
  balanceAfter    Decimal?     @map("balance_after") @db.Decimal(14, 2)
  fingerprint     String
  status          BankTxStatus @default(sin_conciliar)
  matchedType     String?      @map("matched_type")
  matchedId       String?      @map("matched_id")
  matchConfidence Int?         @map("match_confidence")
  matchedAt       DateTime?    @map("matched_at")
  matchedById     String?      @map("matched_by")
  importBatchId   String?      @map("import_batch_id")
  createdAt       DateTime     @default(now()) @map("created_at")

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@unique([bankAccountId, fingerprint])
  @@index([companyId, bankAccountId, txDate(sort: Desc)])
  @@index([bankAccountId, status])
  @@map("bank_transactions")
}

// Lo que el sistema APRENDIO de las conciliaciones manuales.
//
// Cuando el administrador asocia "TRANSF SINPE JIMENEZ M" con la
// filial CASA-01, se guarda ese patron. Al mes siguiente ese mismo
// texto se concilia solo. Es lo que convierte la conciliacion de una
// tarea mensual de horas en una de minutos.
model BankMatchRule {
  id            String   @id @default(uuid())
  companyId     String   @map("company_id")
  bankAccountId String   @map("bank_account_id")
  // Fragmento normalizado del texto bancario.
  pattern       String
  targetType    String   @map("target_type")
  targetId      String   @map("target_id")
  timesUsed     Int      @default(1) @map("times_used")
  lastUsedAt    DateTime @default(now()) @map("last_used_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([bankAccountId, pattern])
  @@index([companyId])
  @@map("bank_match_rules")
}

// ============================================================
// FASE 4 — Fondo de reserva
// ============================================================

// Fondo de reserva del condominio.
//
// El saldo NO se guarda: se deriva de sus movimientos, igual que el
// resto del sistema. La cuenta contable espejo suele ser la 1200.
model ReserveFund {
  id            String   @id @default(uuid())
  companyId     String   @map("company_id")
  condominiumId String   @map("condominium_id")
  name          String
  // Meta a la que se quiere llegar. null = sin meta definida.
  targetAmount  Decimal? @map("target_amount") @db.Decimal(14, 2)
  // Cuota mensual que la asamblea acordo aportar.
  monthlyQuota  Decimal  @default(0) @map("monthly_quota") @db.Decimal(14, 2)
  accountCode   String   @default("1200") @map("account_code")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  condominium Condominium           @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  movements   ReserveFundMovement[]

  @@index([companyId, condominiumId])
  @@map("reserve_funds")
}

enum ReserveMovementType {
  aporte
  uso
}

// Un uso del fondo SIEMPRE lleva justificacion: es dinero que la
// asamblea destino a un fin especifico.
model ReserveFundMovement {
  id          String              @id @default(uuid())
  companyId   String              @map("company_id")
  fundId      String              @map("fund_id")
  movType     ReserveMovementType @map("mov_type")
  amount      Decimal             @db.Decimal(14, 2)
  movDate     DateTime            @map("mov_date") @db.Date
  description String
  // Acuerdo de asamblea o documento que respalda el uso.
  reference   String?
  documentUrl String?             @map("document_url")
  createdById String?             @map("created_by")
  createdAt   DateTime            @default(now()) @map("created_at")

  fund ReserveFund @relation(fields: [fundId], references: [id], onDelete: Cascade)

  @@index([fundId, movDate(sort: Desc)])
  @@map("reserve_fund_movements")
}

// ============================================================
// FASE 5 — Cobranza y convenios
// ============================================================

enum PaymentPlanStatus {
  vigente
  cumplido
  incumplido
  cancelado
}

// Convenio de pago con un condomino moroso.
//
// Mientras el convenio este vigente y al dia, la filial NO devenga
// interes moratorio: cobrarle intereses a quien esta cumpliendo un
// arreglo firmado rompe el arreglo.
model PaymentPlan {
  id            String            @id @default(uuid())
  companyId     String            @map("company_id")
  condominiumId String            @map("condominium_id")
  propertyId    String            @map("property_id")
  totalDebt     Decimal           @map("total_debt") @db.Decimal(14, 2)
  downPayment   Decimal           @default(0) @map("down_payment") @db.Decimal(14, 2)
  installments  Int
  startDate     DateTime          @map("start_date") @db.Date
  status        PaymentPlanStatus @default(vigente)
  notes         String?
  documentUrl   String?           @map("document_url")
  documentName  String?           @map("document_name")
  approvedById  String?           @map("approved_by")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  condominium Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  property    Property    @relation(fields: [propertyId], references: [id])

  @@index([companyId, condominiumId])
  @@index([propertyId, status])
  @@map("payment_plans")
}

enum CollectionActionType {
  recordatorio
  aviso_vencido
  aviso_formal
  aviso_suspension
  expediente_legal
  llamada
  nota
}

// Bitacora de gestion de cobro. Es la prueba de que se gestiono, que
// es lo que se necesita si el caso llega a cobro judicial.
model CollectionAction {
  id            String               @id @default(uuid())
  companyId     String               @map("company_id")
  condominiumId String               @map("condominium_id")
  propertyId    String               @map("property_id")
  actionType    CollectionActionType @map("action_type")
  channel       String?
  notes         String?
  // Monto adeudado al momento de la gestion, congelado.
  debtAmount    Decimal?             @map("debt_amount") @db.Decimal(14, 2)
  daysOverdue   Int?                 @map("days_overdue")
  automated     Boolean              @default(false)
  createdById   String?              @map("created_by")
  createdAt     DateTime             @default(now()) @map("created_at")

  condominium Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  property    Property    @relation(fields: [propertyId], references: [id])

  @@index([companyId, condominiumId, createdAt(sort: Desc)])
  @@index([propertyId, createdAt(sort: Desc)])
  @@map("collection_actions")
}

// ============================================================
// REPOSITORIO DE DOCUMENTOS
// ============================================================
//
// La base NUNCA guarda rutas fisicas ni URLs permanentes: solo el
// proveedor activo y el identificador que ese proveedor asigno. Si
// manana la plataforma migra de Google Drive a S3, los identificadores
// cambian y el resto del sistema no se entera, porque nadie fuera de
// la capa de almacenamiento los interpreta.

enum StorageProviderKind {
  local
  google_drive
  s3
  gcs
  r2
  azure_blob
}

// Configuracion global del repositorio. Una sola fila.
model StorageSettings {
  id           String              @id @default("global")
  provider     StorageProviderKind @default(local)
  // Carpeta raiz "ANEXYpro" en el proveedor activo.
  rootFolderId String?             @map("root_folder_id")
  // Credenciales y opciones del proveedor. Nunca se envian al cliente.
  config       Json?
  updatedAt    DateTime            @updatedAt @map("updated_at")
  updatedById  String?             @map("updated_by")

  @@map("storage_settings")
}

enum StorageFolderKind {
  raiz
  condominios
  condominio
  seccion
  subseccion
  residente
}

// Carpeta del repositorio.
//
// `slug` es la ruta LOGICA y estable ("administracion/actas"): es la
// que usa el codigo. `providerFolderId` es el identificador que dio el
// proveedor y solo lo entiende la capa de almacenamiento.
model StorageFolder {
  id               String              @id @default(uuid())
  companyId        String?             @map("company_id")
  condominiumId    String?             @map("condominium_id")
  // Carpeta individual de un residente.
  personId         String?             @map("person_id")
  parentId         String?             @map("parent_id")
  name             String
  slug             String
  kind             StorageFolderKind
  provider         StorageProviderKind
  providerFolderId String              @map("provider_folder_id")
  // Roles con acceso. Vacio = se aplica la regla por defecto del tipo
  // de carpeta (ver src/lib/services/storage-permissions.ts).
  allowedRoles     String[]            @default([]) @map("allowed_roles")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  company     Company?        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  condominium Condominium?    @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  person      Person?         @relation(fields: [personId], references: [id], onDelete: Cascade)
  parent      StorageFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children    StorageFolder[] @relation("FolderTree")
  objects     StorageObject[]

  @@unique([condominiumId, slug])
  @@index([companyId, condominiumId])
  @@index([personId])
  @@map("storage_folders")
}

enum StorageObjectStatus {
  activo
  eliminado
}

// Metadatos del archivo. Sin ruta, sin URL.
model StorageObject {
  id             String              @id @default(uuid())
  companyId      String              @map("company_id")
  condominiumId  String?             @map("condominium_id")
  folderId       String              @map("folder_id")
  provider       StorageProviderKind
  providerFileId String              @map("provider_file_id")
  name           String
  mimeType       String              @map("mime_type")
  sizeBytes      BigInt              @map("size_bytes")
  // Huella del contenido: permite detectar duplicados y verificar
  // integridad despues de una migracion de proveedor.
  sha256         String
  // Dueno del documento. Si es de un residente, su carpeta manda.
  ownerPersonId  String?             @map("owner_person_id")
  uploadedById   String?             @map("uploaded_by")
  status         StorageObjectStatus @default(activo)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  deletedAt      DateTime?           @map("deleted_at")

  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  condominium Condominium?  @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  folder      StorageFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  person      Person?       @relation(fields: [ownerPersonId], references: [id])

  @@index([companyId, condominiumId, folderId])
  @@index([folderId, status])
  @@index([sha256])
  @@map("storage_objects")
}

// ============================================================
// GESTIÓN DE INCUMPLIMIENTOS
//
// Notificar un incumplimiento del reglamento tiene que costar tres
// pasos y menos de medio minuto: elegir la filial, tocar el tipo de
// incumplimiento y adjuntar la evidencia. Todo lo demás —qué
// corresponde emitir, con qué texto, a quién se le manda y si genera
// multa— lo decide el sistema con lo que la administración configuró.
//
// No hay reglas fijas en el código: cada condominio arma su catálogo y
// su escalamiento. Ver src/lib/domain/violations.ts.
// ============================================================

enum ViolationActionKind {
  advertencia
  multa
}

enum ViolationCaseStatus {
  abierto // el flujo puede seguir escalando
  cerrado // se agotó el escalamiento o la administración lo cerró
  anulado
}

enum ViolationEvidenceKind {
  imagen
  video
}

enum ViolationEmailStatus {
  enviado
  sin_configurar // no hay correo saliente configurado todavía
  error
  sin_destinatario
}

/// Catálogo configurable. Cada condominio define sus incumplimientos,
/// su escalamiento y su plantilla, sin tocar código.
model ViolationType {
  id                String  @id @default(uuid())
  condominiumId     String  @map("condominium_id")
  name              String
  description       String?
  regulationArticle String? @map("regulation_article")

  /// Advertencias que hay que emitir antes de llegar a la multa.
  warningsRequired Int     @default(2) @map("warnings_required")
  /// Días que deben pasar entre una acción y la siguiente.
  daysBetween      Int     @default(15) @map("days_between")
  fineAmount       Decimal @default(0) @map("fine_amount") @db.Decimal(14, 2)
  /// Salta las advertencias: la primera acción ya es la multa.
  immediateFine    Boolean @default(false) @map("immediate_fine")

  /// Los tres formatos del módulo, editables por separado. Admiten
  /// variables entre llaves: {propietario}, {filial}, {condominio},
  /// {fecha}, {hora}, {supervisor}, {administrador}, {articulo},
  /// {incumplimiento}, {observacion}, {monto}, {consecutivo}, {plazo}
  /// y, en la segunda notificación en adelante, {fechaPrimera},
  /// {horaPrimera} y {consecuencia}.
  ///
  /// `warningTemplate` es la PRIMERA notificación; `secondWarningTemplate`
  /// la segunda y siguientes, que tienen que recordar cuándo se envió la
  /// anterior. Si la segunda está vacía se usa el texto estándar, no el
  /// de la primera: decir dos veces lo mismo no advierte de nada.
  warningTemplate       String? @map("warning_template")
  secondWarningTemplate String? @map("second_warning_template")
  fineTemplate          String? @map("fine_template")

  icon      String? // nombre del icono de lucide para el botón grande
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  condominium Condominium     @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  cases       ViolationCase[]

  @@unique([condominiumId, name])
  @@index([condominiumId, isActive, sortOrder])
  @@map("violation_types")
}

/// Identidad del documento: es del condominio, no del tipo de
/// incumplimiento, porque el membrete y la firma son los mismos para
/// todas las notificaciones.
model ViolationSettings {
  id            String  @id @default(uuid())
  condominiumId String  @unique @map("condominium_id")
  logoUrl       String? @map("logo_url")
  primaryColor  String  @default("#3B6EF5") @map("primary_color")
  headerText    String? @map("header_text")
  footerText    String? @map("footer_text")
  adminName     String? @map("admin_name")
  adminDetails  String? @map("admin_details")
  signerName    String? @map("signer_name")
  signerTitle   String? @map("signer_title")
  /// Días de plazo que se le indican al residente para atender el aviso.
  responseDays  Int     @default(8) @map("response_days")

  condominium Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)

  @@map("violation_settings")
}

/// Expediente: una filial y un tipo de incumplimiento. Todas las
/// acciones del escalamiento cuelgan de aquí.
model ViolationCase {
  id              String @id @default(uuid())
  condominiumId   String @map("condominium_id")
  propertyId      String @map("property_id")
  violationTypeId String @map("violation_type_id")
  /// Propietario notificado en el momento de abrir el caso.
  personId        String? @map("person_id")

  caseNumber String              @map("case_number")
  status     ViolationCaseStatus @default(abierto)
  /// Advertencias ya emitidas. La multa no incrementa este contador.
  warningsIssued Int             @default(0) @map("warnings_issued")
  fineIssued     Boolean         @default(false) @map("fine_issued")

  openedAt        DateTime  @default(now()) @map("opened_at")
  lastActionAt    DateTime? @map("last_action_at")
  /// Cuándo corresponde la siguiente acción. De aquí salen los avisos.
  nextActionDueAt DateTime? @map("next_action_due_at")
  closedAt        DateTime? @map("closed_at")
  closeReason     String?   @map("close_reason")

  createdById   String? @map("created_by")
  createdByName String? @map("created_by_name")

  condominium   Condominium       @relation(fields: [condominiumId], references: [id])
  property      Property          @relation(fields: [propertyId], references: [id])
  person        Person?           @relation(fields: [personId], references: [id])
  violationType ViolationType     @relation(fields: [violationTypeId], references: [id])
  actions       ViolationAction[]

  @@index([condominiumId, status])
  @@index([propertyId, violationTypeId, status])
  @@index([condominiumId, nextActionDueAt])
  @@map("violation_cases")
}

/// Cada notificación o resolución emitida. Es la unidad que el
/// residente recibe, lee y confirma.
model ViolationAction {
  id       String              @id @default(uuid())
  caseId   String              @map("case_id")
  kind     ViolationActionKind
  /// 1ª, 2ª… advertencia. La multa siempre lleva 1.
  sequence Int                 @default(1)

  issuedAt      DateTime @default(now()) @map("issued_at")
  issuedById    String?  @map("issued_by")
  issuedByName  String?  @map("issued_by_name")
  supervisorName String? @map("supervisor_name")
  adminName     String?  @map("admin_name")
  observation   String?

  /// Texto que quedó en el documento, ya con las variables resueltas.
  bodyText String? @map("body_text")
  /// Referencia al PDF en el repositorio: /api/archivo/<id>.
  documentRef String? @map("document_ref")

  emailStatus ViolationEmailStatus @default(sin_configurar) @map("email_status")
  emailTo     String?              @map("email_to")
  emailError  String?              @map("email_error")

  /// Multa: cuenta por cobrar generada en el módulo financiero.
  fineAmount Decimal? @map("fine_amount") @db.Decimal(14, 2)
  chargeId   String?  @map("charge_id")

  /// Acuse de lectura del residente en su portal.
  readAt       DateTime? @map("read_at")
  readByUserId String?   @map("read_by")

  case      ViolationCase       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  charge    Charge?             @relation(fields: [chargeId], references: [id])
  evidences ViolationEvidence[]

  @@index([caseId, issuedAt])
  @@index([readAt])
  @@map("violation_actions")
}

/// Fotografías y videos adjuntos a una acción. Viven en el repositorio
/// privado; aquí solo queda la referencia.
model ViolationEvidence {
  id        String                @id @default(uuid())
  actionId  String                @map("action_id")
  fileRef   String                @map("file_ref")
  fileName  String                @map("file_name")
  mimeType  String                @map("mime_type")
  kind      ViolationEvidenceKind @default(imagen)
  sizeBytes Int                   @default(0) @map("size_bytes")
  createdAt DateTime              @default(now()) @map("created_at")

  action ViolationAction @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([actionId])
  @@map("violation_evidences")
}

// ============================================================
// SUSCRIPCIONES
//
// El sistema se usa por suscripción: cada empresa administradora
// contrata un plan con su precio, su periodicidad y su tope de
// condominios. Si se atrasa, el master puede bloquearle el acceso.
//
// **Bloquear NUNCA borra nada.** El bloqueo corta el acceso de algunos
// roles; toda la información del condominio —residentes, finanzas,
// documentos, expedientes— queda intacta y vuelve a estar disponible en
// cuanto se registra el pago.
//
// El estado (al día, por vencer, en gracia, moroso) NO se guarda: se
// deriva de la fecha de pago y los días hábiles de gracia, igual que
// los saldos. Un estado guardado se desincroniza en cuanto pasa un día
// sin que nadie abra la pantalla.
// ============================================================

enum SubscriptionPeriod {
  mensual
  trimestral
  semestral
  anual
}

/// Catálogo de planes que el master ofrece.
model SubscriptionPlan {
  id          String             @id @default(uuid())
  name        String             @unique
  description String?
  price       Decimal            @db.Decimal(12, 2)
  currency    String             @default("CRC")
  period      SubscriptionPeriod @default(mensual)
  /// Condominios que permite crear. 0 = sin tope.
  maxCondominiums Int            @default(0) @map("max_condominiums")
  /// Días HÁBILES de gracia antes de que corresponda bloquear.
  graceDays   Int                @default(5) @map("grace_days")
  isActive    Boolean            @default(true) @map("is_active")
  sortOrder   Int                @default(0) @map("sort_order")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  companies Company[]
  payments  SubscriptionPayment[]

  @@map("subscription_plans")
}

/// Pago registrado de una suscripción. Es el historial de la cuenta.
model SubscriptionPayment {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  planId      String?  @map("plan_id")
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("CRC")
  /// Período que cubre este pago.
  periodStart DateTime @map("period_start") @db.Date
  periodEnd   DateTime @map("period_end") @db.Date
  paidAt      DateTime @default(now()) @map("paid_at")
  method      String?
  reference   String?
  note        String?
  registeredById   String? @map("registered_by")
  registeredByName String? @map("registered_by_name")
  createdAt   DateTime @default(now()) @map("created_at")

  company Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan    SubscriptionPlan? @relation(fields: [planId], references: [id])

  @@index([companyId, periodEnd])
  @@map("subscription_payments")
}
