// El costo es informativo/de reporte; NUNCA genera un cargo
// automático a las unidades — el mantenimiento común se financia con
// la cuota ordinaria que ya cobra Finanzas.
model MaintenanceTicket {
  id            String         @id @default(uuid())
  condominiumId String         @map("condominium_id")
  assetId       String?        @map("asset_id")
  providerId    String?        @map("provider_id")
  incidentId    String?        @map("incident_id")
  ticketType    TicketType     @map("ticket_type")
  title         String
  description   String?
  priority      TicketPriority @default(media)
  status        TicketStatus   @default(reportado)
  scheduledDate DateTime?      @map("scheduled_date") @db.Date
  completedAt   DateTime?      @map("completed_at")
  cost          Decimal?       @db.Decimal(12, 2)
  quoteAmount   Decimal?       @map("quote_amount") @db.Decimal(12, 2)
  source        TicketSource   @default(manual)
  publicVisible Boolean        @default(true) @map("public_visible")
  createdById   String?        @map("created_by")
  createdAt     DateTime       @default(now()) @map("created_at")

  condominium    Condominium        @relation(fields: [condominiumId], references: [id])
  asset          Asset?             @relation(fields: [assetId], references: [id])
  provider       Provider?          @relation(fields: [providerId], references: [id])
  incident       Incident?          @relation(fields: [incidentId], references: [id])
  photos         MaintenancePhoto[]
  journalEntries JournalEntry[]

  @@index([condominiumId, createdAt(sort: Desc)])
  @@index([condominiumId, status])
  @@map("maintenance_tickets")
}

enum PhotoPhase {
  antes
  despues
  evidencia
}

model MaintenancePhoto {
  id           String     @id @default(uuid())
  ticketId     String     @map("ticket_id")
  phase        PhotoPhase
  fileUrl      String     @map("file_url")
  uploadedById String?    @map("uploaded_by")
  uploadedAt   DateTime   @default(now()) @map("uploaded_at")

  ticket MaintenanceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("maintenance_photos")
}

