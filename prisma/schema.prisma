// ============================================================
// GESTIÓN DE PROYECTOS (migración 18)
// ============================================================

enum ProjectStatus {
  planificado
  en_progreso
  pausado
  completado
  cancelado
}

model Project {
  id            String        @id @default(uuid())
  condominiumId String        @map("condominium_id")
  providerId    String?       @map("provider_id") // contratista principal — reutiliza Mantenimiento
  name          String
  description   String?
  startDate     DateTime?     @map("start_date") @db.Date
  endDate       DateTime?     @map("end_date") @db.Date
  budget        Decimal       @default(0) @db.Decimal(14, 2)
  status        ProjectStatus @default(planificado)
  createdById   String?       @map("created_by")
  createdAt     DateTime      @default(now()) @map("created_at")

  condominium Condominium            @relation(fields: [condominiumId], references: [id])
  provider    Provider?              @relation(fields: [providerId], references: [id])
  milestones  ProjectMilestone[]
  checklist   ProjectChecklistItem[]
  // `expenses` es el módulo retirado (ya no se alimenta, pero su
  // historial sigue contando); `financeExpenses` son los gastos de
  // Finanzas imputados al proyecto, que es la vía actual.
  expenses    ProjectExpense[]
  financeExpenses Expense[]
  updates     ProjectUpdate[]
  feeBatches  FeeBatch[] // financiamiento real vía cuota extraordinaria, si se genera

  @@index([condominiumId, createdAt(sort: Desc)])
  @@map("projects")
}

enum MilestoneStatus {
  pendiente
  completado
}

model ProjectMilestone {
  id          String          @id @default(uuid())
  projectId   String          @map("project_id")
  title       String
  dueDate     DateTime?       @map("due_date") @db.Date
  status      MilestoneStatus @default(pendiente)
  completedAt DateTime?       @map("completed_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_milestones")
}

model ProjectChecklistItem {
  id        String  @id @default(uuid())
  projectId String  @map("project_id")
  title     String
  done      Boolean @default(false)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_checklist_items")
}

// El gasto es informativo para el control presupuestario; NUNCA
// genera un cargo automático. El financiamiento real (cuando aplica)
// es una acción deliberada que crea cargos reales en Finanzas
// (charges.chargeType = cuota_extraordinaria vía FeeBatch.projectId).
model ProjectExpense {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  description String
  amount      Decimal  @db.Decimal(14, 2)
  expenseDate DateTime @default(now()) @map("expense_date") @db.Date
  createdById String?  @map("created_by")

  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  journalEntries JournalEntry[]

  @@index([projectId])
  @@map("project_expenses")
}

model ProjectUpdate {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  description String
  progressPct Int?     @map("progress_pct")
  photoUrl    String?  @map("photo_url")
  createdById String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt(sort: Desc)])
  @@map("project_updates")
}

// ============================================================
// CONTABILIDAD INTELIGENTE CON IA (migración 19, ajustada en 23)
// Motor de partida doble real. sub/isOperating agregados en la
// migración 23 tras contrastar contra un estado financiero real
// (ver diseno-modulo-15-contabilidad.md sección "Historial de
// cambios v1.1" — devengo real, no base caja).
// ============================================================

enum AccountType {
  activo
  pasivo
  patrimonio
  ingreso
  gasto
}

enum AccountSub {
  corriente
  no_corriente
}

model ChartOfAccount {
  id          String      @id @default(uuid())
  companyId   String      @map("company_id")
  code        String
  name        String
  type        AccountType
  parentId    String?     @map("parent_id")
  isSystem    Boolean     @default(true) @map("is_system")
  sub         AccountSub? // solo aplica a activo/pasivo
  isOperating Boolean     @default(true) @map("is_operating") // solo aplica a ingreso/gasto

  company      Company          @relation(fields: [companyId], references: [id])
  parent       ChartOfAccount?  @relation("AccountTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children     ChartOfAccount[] @relation("AccountTree")
  journalLines JournalLine[]
  budgetLines  BudgetLine[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("chart_of_accounts")
}

enum JournalSource {
  manual
  cuota
  pago
  gasto_mantenimiento
  gasto_proyecto
  ia
  ajuste
}

enum JournalStatus {
  borrador
  confirmado
  anulado
}

model JournalEntry {
  id            String        @id @default(uuid())
  condominiumId String        @map("condominium_id")
  entryDate     DateTime      @default(now()) @map("entry_date") @db.Date
  description   String
  source        JournalSource @default(manual)
  // Referencias opcionales al registro que originó el asiento —
  // Prisma no modela "referencia polimórfica" nativamente, así que
  // se guardan explícitas (sourceTable + los FKs opcionales de abajo)
  // igual que en el prototipo (source_table/source_id).
  sourceTable   String?       @map("source_table")
  sourceId      String?       @map("source_id")
  chargeId      String?       @map("charge_ref_id")
  paymentId     String?       @map("payment_ref_id")
  ticketId      String?       @map("ticket_ref_id")
  expenseId     String?       @map("expense_ref_id")
  status        JournalStatus @default(confirmado)
  createdById   String?       @map("created_by")
  createdAt     DateTime      @default(now()) @map("created_at")

  condominium Condominium        @relation(fields: [condominiumId], references: [id])
  charge      Charge?            @relation(fields: [chargeId], references: [id])
  payment     Payment?           @relation(fields: [paymentId], references: [id])
  ticket      MaintenanceTicket? @relation(fields: [ticketId], references: [id])
  expense     ProjectExpense?    @relation(fields: [expenseId], references: [id])
  lines       JournalLine[]

  @@index([condominiumId, entryDate(sort: Desc)])
  @@map("journal_entries")
}

// CHECK (debit>0 XOR credit>0) y el balance global del asiento se
// validan en src/lib/services/accounting.ts (createJournalEntry),
// replicando exactamente la función del prototipo — misma regla que
// el trigger check_journal_balance en prisma/sql/.
model JournalLine {
  id        String  @id @default(uuid())
  entryId   String  @map("entry_id")
  accountId String  @map("account_id")
  debit     Decimal @default(0) @db.Decimal(14, 2)
  credit    Decimal @default(0) @db.Decimal(14, 2)

  entry   JournalEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account ChartOfAccount @relation(fields: [accountId], references: [id])

  @@index([entryId])
  @@index([accountId])
  @@map("journal_lines")
}

model BudgetLine {
  id             String  @id @default(uuid())
  condominiumId  String  @map("condominium_id")
  accountId      String  @map("account_id")
  period         String // 'YYYY' o 'YYYY-MM'
  budgetedAmount Decimal @default(0) @map("budgeted_amount") @db.Decimal(14, 2)

  condominium Condominium    @relation(fields: [condominiumId], references: [id])
  account     ChartOfAccount @relation(fields: [accountId], references: [id])

  @@unique([condominiumId, accountId, period])
  @@map("budget_lines")
}

// ============================================================
// ASAMBLEAS (migración 20)
// ============================================================

enum AssemblyType {
  ordinaria
  extraordinaria
}

enum AssemblyStatus {
  convocada
  en_curso
  cerrada
  cancelada
}

model Assembly {
  id                  String         @id @default(uuid())
  condominiumId       String         @map("condominium_id")
  type                AssemblyType
  title               String
  eventDate           DateTime       @map("event_date") @db.Date
  eventTime           String         @map("event_time")
  location            String?
  status              AssemblyStatus @default(convocada)
  convocatoriaBody    String         @map("convocatoria_body")
  quorumRequiredPct   Decimal        @default(50.0) @map("quorum_required_pct") @db.Decimal(5, 2)
  minutesBody         String?        @map("minutes_body")
  minutesPublished    Boolean        @default(false) @map("minutes_published")
  minutesPublishedAt  DateTime?      @map("minutes_published_at")
  minutesApprovedById String?        @map("minutes_approved_by")
  createdById         String?        @map("created_by")
  createdAt           DateTime       @default(now()) @map("created_at")

  condominium Condominium          @relation(fields: [condominiumId], references: [id])
  attachments AssemblyAttachment[]
  topics      AssemblyTopic[]
  attendance  AssemblyAttendance[]

  @@index([condominiumId, eventDate(sort: Desc)])
  @@map("assemblies")
}

model AssemblyAttachment {
  id           String   @id @default(uuid())
  assemblyId   String   @map("assembly_id")
  fileName     String   @map("file_name")
  fileUrl      String   @map("file_url")
  uploadedById String?  @map("uploaded_by")
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  assembly Assembly @relation(fields: [assemblyId], references: [id], onDelete: Cascade)

  @@index([assemblyId])
  @@map("assembly_attachments")
}

model AssemblyTopic {
  id           String  @id @default(uuid())
  assemblyId   String  @map("assembly_id")
  title        String
  description  String?
  sortOrder    Int     @default(0) @map("sort_order")
  requiresVote Boolean @default(false) @map("requires_vote")

  assembly Assembly      @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  vote     AssemblyVote?

  @@index([assemblyId])
  @@map("assembly_topics")
}

enum VoteStatus {
  abierta
  cerrada
}

model AssemblyVote {
  id       String     @id @default(uuid())
  topicId  String     @unique @map("topic_id")
  status   VoteStatus @default(abierta)
  openedAt DateTime   @default(now()) @map("opened_at")
  closedAt DateTime?  @map("closed_at")

  topic   AssemblyTopic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  ballots AssemblyBallot[]

  @@map("assembly_votes")
}

enum BallotChoice {
  a_favor
  en_contra
  abstencion
}

// Un voto por unidad por votación, sin excepción — la administración
// NUNCA puede emitir ni modificar un voto (decisión de producto
// explícita, ver diseno-modulo-16-asambleas.md "Historial de cambios
// v1.1"). Solo existe una vía de escritura: el residente autenticado
// votando por su propia unidad.
model AssemblyBallot {
  id         String       @id @default(uuid())
  voteId     String       @map("vote_id")
  propertyId String       @map("property_id")
  voterName  String       @map("voter_name")
  choice     BallotChoice
  castAt     DateTime     @default(now()) @map("cast_at")

  vote     AssemblyVote @relation(fields: [voteId], references: [id], onDelete: Cascade)
  property Property     @relation(fields: [propertyId], references: [id])

  @@unique([voteId, propertyId])
  @@map("assembly_ballots")
}

model AssemblyAttendance {
  id         String  @id @default(uuid())
  assemblyId String  @map("assembly_id")
  propertyId String  @map("property_id")
  present    Boolean @default(false)
  proxyName  String? @map("proxy_name")

  assembly Assembly @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id])

  @@unique([assemblyId, propertyId])
  @@map("assembly_attendance")
}

// ============================================================
// GESTIÓN DOCUMENTAL (migración 21)
// ============================================================

enum DocCategory {
  reglamento
  contrato
  manual
  seguro
  garantia
  plano
  otro
}

enum DocVisibility {
  admin
  residentes
}

enum DocStatus {
  vigente
  archivado
}

model Document {
  id             String        @id @default(uuid())
  condominiumId  String        @map("condominium_id")
  category       DocCategory
  title          String
  visibility     DocVisibility @default(admin)
  status         DocStatus     @default(vigente)
  expiresOn      DateTime?     @map("expires_on") @db.Date
  currentVersion Int           @default(1) @map("current_version")
  // Contenido de texto plano del documento — SOLO se usa para
  // fundamentar al Árbitro Legal IA (ver src/lib/services/legal-assistant.ts).
  // Sin esto, cualquier asistente de IA tendría que fabricar el
  // contenido del reglamento en vez de citarlo — se deja en blanco
  // hasta que la administración lo complete a propósito.
  bodyText       String?       @map("body_text")
  createdById    String?       @map("created_by")
  createdAt      DateTime      @default(now()) @map("created_at")

  condominium Condominium       @relation(fields: [condominiumId], references: [id])
  versions    DocumentVersion[]

  @@index([condominiumId, category])
  @@map("documents")
}

// Cada subida agrega una fila — nunca se sobrescribe una versión.
model DocumentVersion {
  id           String   @id @default(uuid())
  documentId   String   @map("document_id")
  version      Int
  fileName     String   @map("file_name")
  fileUrl      String   @map("file_url")
  notes        String?
  uploadedById String?  @map("uploaded_by")
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@map("document_versions")
}

// ============================================================
// AUDITORÍA — módulo 1.19 (migración 22)
// Bitácora de ACTIVIDAD legible, distinta de SystemAuditEntry
