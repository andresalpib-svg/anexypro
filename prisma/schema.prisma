// ============================================================
// ANEXYpro — schema.prisma
// Traducción fiel de las 23 migraciones SQL ya diseñadas y
// probadas en el prototipo (ver /home/claude/anexypro/schema-modulo-*.sql
// y los documentos diseno-modulo-*.md correspondientes).
//
// Las VISTAS SQL (v_property_balance, v_delinquency, v_libro_mayor,
// etc.), los TRIGGERS de integridad (check_journal_balance,
// sync_charge_status, enforce_reservation_receipt, check_unique_plate)
// y las FUNCIONES (water_amount, fx_rate_for) no se traducen aquí —
// Prisma no las modela de forma nativa con la misma fidelidad. Viven
// en prisma/sql/01_views_functions_triggers.sql y se aplican como
// parte de la migración inicial (ver prisma/migrations/README.md).
// La misma lógica de negocio que esas vistas resuelven en la base de
// datos también existe en src/lib/services/*.ts, para que la capa de
// aplicación no dependa únicamente de SQL crudo.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

// `url` es el rol de la APLICACIÓN: sin SUPERUSER ni BYPASSRLS, y no
// dueño de las tablas. Es lo que hace que Row-Level Security se aplique
// de verdad (ver prisma/sql/03_rls_endurecido.sql).
//
// `directUrl` es el DUEÑO de las tablas, y solo lo usan las migraciones
// y `prisma db push`: el rol de la aplicación no puede alterar la
// estructura, que es justamente lo que se busca.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// FUNDACIÓN MULTI-TENANT (migración 01)
// ============================================================

enum CompanyStatus {
  activa
  suspendida
  inactiva
}

model Company {
  id            String        @id @default(uuid())
  legalName     String        @map("legal_name")
  tradeName     String?       @map("trade_name")
  taxId         String?       @map("tax_id")
  email         String?
  phone         String?
  logoUrl       String?       @map("logo_url")
  /// Identidad visual de la empresa administradora. El panel de sus
  /// usuarios se pinta con estos colores; si están vacíos se usa el
  /// azul de ANEXYpro. Ver `src/lib/branding.ts`.
  brandPrimary  String?       @map("brand_primary")
  brandDeep     String?       @map("brand_deep")
  status        CompanyStatus @default(activa)

  // ---------- Suscripción ----------
  planId                String?   @map("plan_id")
  /// Próxima fecha de pago. De aquí sale todo el estado de la cuenta.
  nextPaymentDate       DateTime? @map("next_payment_date") @db.Date
  subscriptionStartedAt DateTime? @map("subscription_started_at") @db.Date
  /// Cuándo se le cortó el acceso. Null = no está bloqueada.
  /// Bloquear no borra información: solo cierra el paso.
  blockedAt             DateTime? @map("blocked_at")
  blockReason           String?   @map("block_reason")
  // Módulos del panel que el usuario master oculta para esta empresa.
  // Se guardan los href de nav-config (p. ej. "/app/proyectos").
  hiddenModules String[]      @default([]) @map("hidden_modules")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  plan                 SubscriptionPlan?     @relation(fields: [planId], references: [id])
  subscriptionPayments SubscriptionPayment[]
  users         User[]
  condominiums  Condominium[]
  persons       Person[]
  suppliers     Supplier[]
  chartAccounts ChartOfAccount[]
  auditEntries  SystemAuditEntry[]
  activityLog   AuditLog[]
  StorageFolder StorageFolder[]
  StorageObject StorageObject[]

  @@map("companies")
}

enum UserRole {
  master // plataforma: ve todas las empresas administradoras
  admin_owner
  admin_staff
  seguridad
  condomino
  // Contador externo: ve finanzas y contabilidad, nunca residentes,
  // visitas ni seguridad.
  contador
}

enum UserStatus {
  activo
  invitado
  bloqueado
  inactivo
}

// staffPermissions: {"finanzas": false, "asambleas": false, ...} —
// NULL/vacío = acceso completo. Ver src/lib/rbac.ts para la función
// can(area) que evalúa esto igual que el prototipo.
model User {
  id               String     @id @default(uuid())
  companyId        String     @map("company_id")
  email            String // citext en Postgres — case-insensitive, ver migración raw
  passwordHash     String     @map("password_hash")
  fullName         String     @map("full_name")
  phone            String?
  photoUrl         String?    @map("photo_url")
  role             UserRole   @default(admin_staff)
  staffPermissions Json?      @map("staff_permissions")
  status           UserStatus @default(activo)
  lastLoginAt      DateTime?  @map("last_login_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  company              Company                 @relation(fields: [companyId], references: [id])
  createdCondominiums  Condominium[]           @relation("CondoCreatedBy")
  person               Person?                 @relation("PersonUser")
  authLogs             AuthLog[]
  systemAudits         SystemAuditEntry[]
  activityLogs         AuditLog[]
  assignedTasks        AdminTask[]             @relation("TaskAssignee")
  pettyCashAllocations PettyCashAllocation[]   @relation("PettyCashAllocatedBy")
  pettyCashExpenses    PettyCashExpense[]      @relation("PettyCashSpentBy")
  createdExpenses      Expense[]               @relation("ExpenseCreatedBy")
  approvedExpenses     Expense[]               @relation("ExpenseApprovedBy")
  closedPeriods        AccountingPeriod[]      @relation("PeriodClosedBy")
  supervisedCondos     CondominiumSupervisor[]
  // Relaciones "createdBy"/"receivedBy"/etc. de otros módulos se
  // omiten del lado User (unidireccionales) para no inflar este
  // modelo con decenas de relaciones inversas sin valor de consulta.

  @@unique([companyId, email])
  @@index([companyId])
  @@map("users")
}

enum CondoType {
  residencial
  vertical
  mixto
  comercial
}

enum CondoStatus {
  configuracion
  activo
  inactivo
}

model Condominium {
  id          String      @id @default(uuid())
  companyId   String      @map("company_id")
  name        String
  code        String
  type        CondoType
  addressLine String?     @map("address_line")
  province    String?
  canton      String?
  district    String?
  country     String      @default("CR")
  latitude    Decimal?    @db.Decimal(9, 6)
  longitude   Decimal?    @db.Decimal(9, 6)
  timezone    String      @default("America/Costa_Rica")
  currency    String      @default("CRC") // CRC | USD
  logoUrl     String?     @map("logo_url")
  status      CondoStatus @default(configuracion)
  notes       String?
  createdById String?     @map("created_by")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  deletedAt   DateTime?   @map("deleted_at")

  company              Company                       @relation(fields: [companyId], references: [id])
  violationTypes       ViolationType[]
  violationSettings    ViolationSettings?
  violationCases       ViolationCase[]
  createdBy            User?                         @relation("CondoCreatedBy", fields: [createdById], references: [id])
  structuralUnits      StructuralUnit[]
  properties           Property[]
  amenities            Amenity[]
  financialSettings    CondominiumFinancialSettings?
  documents            CondominiumDocument[]
  feeBatches           FeeBatch[]
  charges              Charge[]
  payments             Payment[]
  waterTariffTiers     WaterTariffTier[]
  billingRunLogs       BillingRunLog[]
  communications       Communication[]
  reservations         Reservation[]
  calendarEvents       CalendarEvent[]
  visitAuthorizations  VisitAuthorization[]
  incidents            Incident[]
  packages             Package[]
  contentItems         ContentItem[]
  assets               Asset[]
  providers            Provider[]
  maintenanceTickets   MaintenanceTicket[]
  projects             Project[]
  adminTasks           AdminTask[]
  pettyCashAllocations PettyCashAllocation[]
  pettyCashExpenses    PettyCashExpense[]
  bankAccounts         BankAccount[]
  expenses             Expense[]
  accountingPeriods    AccountingPeriod[]
  recurringExpenses    RecurringExpense[]
  contracts            Contract[]
  reserveFunds         ReserveFund[]
  paymentPlans         PaymentPlan[]
  collectionActions    CollectionAction[]
  storageFolders       StorageFolder[]
  storageObjects       StorageObject[]
  journalEntries       JournalEntry[]
  budgetLines          BudgetLine[]
  assemblies           Assembly[]
  docs                 Document[]
  supervisors          CondominiumSupervisor[]
  docRequests          DocumentRequest[]
  docTemplates         DocumentTemplate[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("condominiums")
}

enum StructUnitType {
  etapa
  torre
  bloque
  sector
}

model StructuralUnit {
  id            String         @id @default(uuid())
  condominiumId String         @map("condominium_id")
  parentId      String?        @map("parent_id")
  unitType      StructUnitType @map("unit_type")
  name          String
  sortOrder     Int            @default(0) @map("sort_order")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  condominium Condominium           @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  parent      StructuralUnit?       @relation("StructTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children    StructuralUnit[]      @relation("StructTree")
  properties  Property[]
  commTargets CommunicationTarget[]

  @@unique([condominiumId, parentId, name])
  @@index([condominiumId])
  @@index([parentId])
  @@map("structural_units")
}

enum PropertyType {
  casa
  apartamento
  local
  lote
  parqueo
  bodega
}

enum PropertyStatus {
  activa
  inactiva
}

model Property {
  id               String         @id @default(uuid())
  condominiumId    String         @map("condominium_id")
  structuralUnitId String?        @map("structural_unit_id")
  code             String
  propertyType     PropertyType   @map("property_type")
  floor            Int?
  areaM2           Decimal?       @map("area_m2") @db.Decimal(10, 2)
  coefficient      Decimal?       @db.Decimal(8, 5)
  parkingSpaces    Int            @default(0) @map("parking_spaces") // migración 05
  status           PropertyStatus @default(activa)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  condominium         Condominium                 @relation(fields: [condominiumId], references: [id])
  structuralUnit      StructuralUnit?             @relation(fields: [structuralUnitId], references: [id])
  members             PropertyMember[]
  docRequests         DocumentRequest[]
  vehicles            Vehicle[]
  pets                Pet[]
  emergencyContacts   EmergencyContact[]
  events              PropertyEvent[]
  charges             Charge[]
  payments            Payment[]
  waterReadings       WaterReading[]
  suspensions         PropertyServiceSuspension[]
  commTargets         CommunicationTarget[]
  commRecipients      CommunicationRecipient[]
  reservations        Reservation[]
  visitAuthorizations VisitAuthorization[]
  violationCases      ViolationCase[]
  packages            Package[]
  assemblyBallots     AssemblyBallot[]
  assemblyAttendance  AssemblyAttendance[]
  paymentPlans        PaymentPlan[]
  collectionActions   CollectionAction[]

  @@unique([condominiumId, code])
  @@index([condominiumId])
  @@index([structuralUnitId])
  @@map("properties")
}

enum AmenityStatus {
  disponible
  mantenimiento
  limpieza
  fuera_de_servicio
}

model Amenity {
  id               String        @id @default(uuid())
  condominiumId    String        @map("condominium_id")
  name             String
  description      String?
  capacity         Int?
  requiresApproval Boolean       @default(false) @map("requires_approval")
  reservationCost  Decimal       @default(0) @map("reservation_cost") @db.Decimal(12, 2)
  maxHours         Int?          @map("max_hours")
  advanceDays      Int           @default(30) @map("advance_days")
  rules            String?
  rulesUrl         String?       @map("rules_url") // normativa de uso adjunta (PDF/imagen)
  photoUrl         String?       @map("photo_url") // imagen de portada del área
  // true = una reserva vigente bloquea el DÍA COMPLETO del área
  exclusivePerDay  Boolean       @default(true) @map("exclusive_per_day")
  status           AmenityStatus @default(disponible)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  condominium  Condominium           @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  schedules    AmenitySchedule[]
  reservations Reservation[]
  documents    CondominiumDocument[]

  @@unique([condominiumId, name])
  @@map("amenities")
}

model AmenitySchedule {
  id        String @id @default(uuid())
  amenityId String @map("amenity_id")
  dayOfWeek Int    @map("day_of_week") // 0 = domingo
  opensAt   String @map("opens_at") // time — Prisma no tiene tipo `time`; se guarda "HH:MM"
  closesAt  String @map("closes_at")

  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@index([amenityId])
  @@map("amenity_schedules")
}

enum InterestType {
  simple
  compuesto
}

enum FeeCalculation {
  fija
  por_coeficiente
  por_area
}

enum WaterMode {
  sin_cobro
  tarifa_plana
  escalonado
}

// 1:1 con Condominium. Incluye los campos agregados en migraciones
// 05 (facturación automática, agua) y 07 (suspensión de servicios).
model CondominiumFinancialSettings {
  condominiumId            String         @id @map("condominium_id")
  baseFee                  Decimal        @default(0) @map("base_fee") @db.Decimal(14, 2)
  billingDay               Int            @default(1) @map("billing_day")
  dueDay                   Int            @default(15) @map("due_day")
  graceDays                Int            @default(0) @map("grace_days")
  lateInterestRate         Decimal        @default(0) @map("late_interest_rate") @db.Decimal(6, 3)
  interestType             InterestType   @default(simple) @map("interest_type")
  feeCalculation           FeeCalculation @default(fija) @map("fee_calculation")
  // Migración 05 — facturación automática y agua
  autoBilling              Boolean        @default(true) @map("auto_billing")
  autoBillingDay           Int            @default(1) @map("auto_billing_day")
  parkingFee               Decimal        @default(0) @map("parking_fee") @db.Decimal(12, 2)
  waterMode                WaterMode      @default(sin_cobro) @map("water_mode")
  waterFlatFee             Decimal        @default(0) @map("water_flat_fee") @db.Decimal(12, 2)
  // Migración 07 — suspensión de servicios
  suspensionEnabled        Boolean        @default(true) @map("suspension_enabled")
  suspensionMonths         Int            @default(3) @map("suspension_months")
  // --- Intereses moratorios (fase 1) ---
  // Apagado por defecto A PROPÓSITO: activar el cobro de intereses es
  // una decisión de la administración, no algo que deba pasar solo al
  // actualizar el sistema.
  autoInterest             Boolean        @default(false) @map("auto_interest")
  // Días de gracia propios de la mora. Si es null se usa graceDays.
  interestGraceDays        Int?           @map("interest_grace_days")
  // Tope: el interés acumulado de un cargo nunca supera este
  // porcentaje del cargo base. 0 = sin tope.
  interestMaxPct           Decimal        @default(30) @map("interest_max_pct") @db.Decimal(6, 2)
  // --- Gastos (fase 1) ---
  // Monto a partir del cual un gasto requiere aprobación.
  // 0 = no se exige aprobación al administrador propietario.
  // Los gastos creados por un supervisor SIEMPRE requieren aprobación.
  expenseApprovalThreshold Decimal        @default(0) @map("expense_approval_threshold") @db.Decimal(14, 2)
  updatedAt                DateTime       @updatedAt @map("updated_at")

  condominium Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)

  @@map("condominium_financial_settings")
}

enum CondoDocType {
  reglamento
  reglamento_uso_area
  manual
  plano
  seguro
  otro
}

// Documentos mínimos de condominio (migración 01) — el módulo 1.14
// completo (con versionado real) vive en Document/DocumentVersion.
model CondominiumDocument {
  id            String       @id @default(uuid())
  condominiumId String       @map("condominium_id")
  amenityId     String?      @map("amenity_id")
  docType       CondoDocType @map("doc_type")
  title         String
  fileUrl       String       @map("file_url")
  version       Int          @default(1)
  uploadedById  String?      @map("uploaded_by")
  createdAt     DateTime     @default(now()) @map("created_at")

  condominium Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  amenity     Amenity?    @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@index([condominiumId])
  @@index([amenityId])
  @@map("condominium_documents")
}

// Auditoría genérica de CRUD (migración 01) — diff antes/después.
// Distinta del módulo 1.19 (AuditLog más abajo), que es la bitácora
// de ACTIVIDAD legible para el administrador, no un diff técnico.
enum AuditAction {
  crear
  actualizar
  eliminar
}

model SystemAuditEntry {
  id            BigInt      @id @default(autoincrement())
  companyId     String      @map("company_id")
  condominiumId String?     @map("condominium_id")
  userId        String?     @map("user_id")
  entity        String
  entityId      String?     @map("entity_id")
  action        AuditAction
  changes       Json?
  ip            String?
  userAgent     String?     @map("user_agent")
  createdAt     DateTime    @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@index([companyId, createdAt(sort: Desc)])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ============================================================
// PERSONAS Y RESIDENTES (migraciones 02-03)
// ============================================================

model Person {
  id            String    @id @default(uuid())
  companyId     String    @map("company_id")
  userId        String?   @unique @map("user_id")
  fullName      String    @map("full_name")
  idNumber      String?   @map("id_number")
  email         String?
  phone         String?
  phoneAlt      String?   @map("phone_alt")
  birthDate     DateTime? @map("birth_date") @db.Date
  photoUrl      String?   @map("photo_url")
  notes         String?
  isBoardMember Boolean   @default(false) @map("is_board_member")
  boardAreas    String[]  @default([]) @map("board_areas")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  company               Company                  @relation(fields: [companyId], references: [id])
  user                  User?                    @relation("PersonUser", fields: [userId], references: [id])
  memberships           PropertyMember[]
  violationCases        ViolationCase[]
  vehicles              Vehicle[]
  documents             PersonDocument[]
  invitations           PersonInvitation[]
  docRequests           DocumentRequest[]
  commTargets           CommunicationTarget[]
  commRecipients        CommunicationRecipient[]
  requestedReservations Reservation[]
  storageFolders        StorageFolder[]
  storageObjects        StorageObject[]

  @@index([companyId])
  @@index([companyId, idNumber])
  @@map("persons")
}

enum PropertyRole {
  propietario
  residente
  inquilino
  familiar
  empleado
}

model PropertyMember {
  id         String       @id @default(uuid())
  propertyId String       @map("property_id")
  personId   String       @map("person_id")
  role       PropertyRole
  isPrimary  Boolean      @default(false) @map("is_primary")
  startDate  DateTime     @default(now()) @map("start_date") @db.Date
  endDate    DateTime?    @map("end_date") @db.Date
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  property        Property               @relation(fields: [propertyId], references: [id])
  person          Person                 @relation(fields: [personId], references: [id])
  accessSchedules MemberAccessSchedule[]

  @@index([propertyId])
  @@index([personId])
  @@map("property_members")
}

model MemberAccessSchedule {
  id        String @id @default(uuid())
  memberId  String @map("member_id")
  dayOfWeek Int    @map("day_of_week")
  startsAt  String @map("starts_at")
  endsAt    String @map("ends_at")

  member PropertyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, dayOfWeek, startsAt])
  @@index([memberId])
  @@map("member_access_schedules")
}

enum VehicleType {
  automovil
  motocicleta
  bicicleta
  otro
}

enum VehicleStatus {
  activo
  inactivo
}

model Vehicle {
  id          String        @id @default(uuid())
  propertyId  String        @map("property_id")
  personId    String?       @map("person_id")
  driverName  String?       @map("driver_name")
  plate       String
  brand       String?
  model       String?
  color       String?
  vehicleType VehicleType   @default(automovil) @map("vehicle_type")
  parkingCode String?       @map("parking_code")
  photoUrl    String?       @map("photo_url")
  status      VehicleStatus @default(activo)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id])
  person   Person?  @relation(fields: [personId], references: [id])

  @@index([propertyId])
  @@index([plate])
  @@map("vehicles")
}

enum PetSpecies {
  perro
  gato
  ave
  otro
}

model Pet {
  id          String     @id @default(uuid())
  propertyId  String     @map("property_id")
  name        String
  species     PetSpecies @default(perro)
  breed       String?
  color       String?
  vaccinesOk  Boolean    @default(false) @map("vaccines_ok")
  vaccinesDue DateTime?  @map("vaccines_due") @db.Date
  photoUrl    String?    @map("photo_url")
  notes       String?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id])

  @@index([propertyId])
  @@map("pets")
}

model EmergencyContact {
  id           String   @id @default(uuid())
  propertyId   String   @map("property_id")
  name         String
  relationship String?
  phone        String
  phoneAlt     String?  @map("phone_alt")
  priority     Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id])

  @@index([propertyId])
  @@map("emergency_contacts")
}

enum PropertyEventType {
  creacion
  traspaso
  nuevo_miembro
  salida_miembro
  vehiculo
  mascota
  contacto
  nota
  suspension_activada
  suspension_levantada
  pago
  cargo
  reserva
  comunicado
  otro
}

model PropertyEvent {
  id          BigInt            @id @default(autoincrement())
  propertyId  String            @map("property_id")
  eventType   PropertyEventType @map("event_type")
  description String
  createdById String?           @map("created_by")
  createdAt   DateTime          @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id])

  @@index([propertyId, createdAt(sort: Desc)])
  @@map("property_events")
}

enum PersonDocType {
  identificacion
  contrato_alquiler
  autorizacion
  otro
}

model PersonDocument {
  id           String        @id @default(uuid())
  personId     String        @map("person_id")
  docType      PersonDocType @map("doc_type")
  title        String
  fileUrl      String        @map("file_url")
  uploadedById String?       @map("uploaded_by")
  createdAt    DateTime      @default(now()) @map("created_at")

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
  @@map("person_documents")
}

enum InvitationStatus {
  pendiente
  aceptada
  expirada
  revocada
}

model PersonInvitation {
  id            String           @id @default(uuid())
  personId      String           @map("person_id")
  condominiumId String           @map("condominium_id")
  email         String
  token         String           @unique
  status        InvitationStatus @default(pendiente)
  expiresAt     DateTime         @map("expires_at")
  acceptedAt    DateTime?        @map("accepted_at")
  createdById   String?          @map("created_by")
  createdAt     DateTime         @default(now()) @map("created_at")

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
  @@map("person_invitations")
