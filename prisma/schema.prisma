model VisitAuthorization {
  id              String      @id @default(uuid())
  condominiumId   String      @map("condominium_id")
  propertyId      String      @map("property_id")
  authorizedById  String?     @map("authorized_by") // persona que autoriza (residente u oficial)
  visitType       VisitType   @map("visit_type")
  visitorName     String      @map("visitor_name")
  visitorIdNumber String?     @map("visitor_id_number")
  vehiclePlate    String?     @map("vehicle_plate")
  courier         String? // empresa (entregas/empleados)
  visitorPhotoUrl String?     @map("visitor_photo_url") // recurrentes/empleados
  phone           String?
  relation        String? // motivo / relación con el residente
  arrivalTime     String?     @map("arrival_time") // hora estimada (rápidas)
  suspendedAt     DateTime?   @map("suspended_at")
  code            String      @unique // base del QR
  validDate       DateTime?   @map("valid_date") @db.Date // rápida/entrega
