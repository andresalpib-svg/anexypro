// ============================================================
// FINANZAS (migraciones 04-07)
// Principios: nada se borra (se anula), el saldo siempre se
// deriva, los pagos se aplican al cargo más antiguo primero.
// ============================================================

enum BatchType {
  ordinaria
  extraordinaria
}

model FeeBatch {
  id            String    @id @default(uuid())
  condominiumId String    @map("condominium_id")
  batchType     BatchType @map("batch_type")
  period        DateTime  @db.Date
  description   String
  totalAmount   Decimal   @map("total_amount") @db.Decimal(16, 2)
  unitsCount    Int       @map("units_count")
  projectId     String?   @map("project_id") // migración 18 — referencia informativa
  createdById   String?   @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  revertedAt    DateTime? @map("reverted_at")

  condominium Condominium @relation(fields: [condominiumId], references: [id])
  charges     Charge[]
  project     Project?    @relation(fields: [projectId], references: [id])

  @@unique([condominiumId, batchType, period])
  @@map("fee_batches")
}

enum ChargeType {
  cuota_ordinaria
  cuota_extraordinaria
  interes_moratorio
  multa
  reposicion_danos
  mantenimiento_parqueo
  agua_potable
  quick_pass
  reserva_area_social
  otro
}

enum ChargeStatus {
  pendiente
  parcial
  pagado
  anulado
}

model Charge {
  id                   String       @id @default(uuid())
  condominiumId        String       @map("condominium_id")
  propertyId           String       @map("property_id")
  batchId              String?      @map("batch_id")
  chargeType           ChargeType   @map("charge_type")
  description          String
  period               DateTime?    @db.Date
  amount               Decimal      @db.Decimal(14, 2)
  dueDate              DateTime     @map("due_date") @db.Date
  status               ChargeStatus @default(pendiente)
  createdById          String?      @map("created_by")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  voidedAt             DateTime?    @map("voided_at")
  voidReason           String?      @map("void_reason")
  // Solo en cargos de tipo interes_moratorio: de qué cargo nacen y
  // hasta qué fecha se calculó. Es lo que hace idempotente el cálculo.
  interestBaseChargeId String?      @map("interest_base_charge_id")
  interestThroughDate  DateTime?    @map("interest_through_date") @db.Date

  condominium     Condominium         @relation(fields: [condominiumId], references: [id])
  property        Property            @relation(fields: [propertyId], references: [id])
  batch           FeeBatch?           @relation(fields: [batchId], references: [id])
  interestBase    Charge?             @relation("ChargeInterest", fields: [interestBaseChargeId], references: [id])
  interestCharges Charge[]            @relation("ChargeInterest")
  allocations     PaymentAllocation[]
  violationActions ViolationAction[]
  waterReading    WaterReading?
  reservation     Reservation?
  journalEntries  JournalEntry[]

  @@index([propertyId, dueDate])
  @@index([condominiumId, period])
  // El filtro más usado del producto: cargos pendientes o parciales ya
  // vencidos de un condominio. Lo hacen morosidad, cobranza, intereses
  // moratorios y los reportes. Sin este índice es un recorrido completo
  // de la tabla, que solo crece.
  @@index([condominiumId, status, dueDate])
  @@map("charges")
}

enum PaymentMethod {
  transferencia
  sinpe
  efectivo
  tarjeta
  deposito
  comprobante
}

enum PaymentStatus {
  aplicado
  anulado
}

enum PaidCurrency {
  CRC
  USD
}

model Payment {
  id             String        @id @default(uuid())
  condominiumId  String        @map("condominium_id")
  propertyId     String        @map("property_id")
  amount         Decimal       @db.Decimal(14, 2) // siempre en la moneda del condominio
  paymentDate    DateTime      @default(now()) @map("payment_date") @db.Date
  method         PaymentMethod
  reference      String?
  notes          String?
  receiptUrl     String?       @map("receipt_url")
  paidCurrency   PaidCurrency  @default(CRC) @map("paid_currency")
  originalAmount Decimal?      @map("original_amount") @db.Decimal(14, 2)
  fxRate         Decimal?      @map("fx_rate") @db.Decimal(10, 4)
  fxDate         DateTime?     @map("fx_date") @db.Date
  receivedById   String?       @map("received_by")
  status         PaymentStatus @default(aplicado)
  createdAt      DateTime      @default(now()) @map("created_at")
  voidedAt       DateTime?     @map("voided_at")
  voidReason     String?       @map("void_reason")

  condominium    Condominium         @relation(fields: [condominiumId], references: [id])
  property       Property            @relation(fields: [propertyId], references: [id])
  allocations    PaymentAllocation[]
  journalEntries JournalEntry[]

  @@index([propertyId, paymentDate])
  // Listado de pagos del condominio por fecha, y la columna por la que
  // filtra su propia política de RLS (`tenant_payments`).
  @@index([condominiumId, paymentDate(sort: Desc)])
  @@map("payments")
}

model PaymentAllocation {
  id        String   @id @default(uuid())
  paymentId String   @map("payment_id")
  chargeId  String   @map("charge_id")
  amount    Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id])
  charge  Charge  @relation(fields: [chargeId], references: [id])

  @@unique([paymentId, chargeId])
  @@index([chargeId])
  @@map("payment_allocations")
}

enum BillingRunStatus {
  ok
  omitido
  error
}

// Trazabilidad de la automatización — SOLO la cuota condominal
// ordinaria se genera y notifica de forma automática (migración 07);
// todo lo demás (extraordinaria, agua, parqueo, multas...) es manual.
model BillingRunLog {
  id            BigInt           @id @default(autoincrement())
  condominiumId String           @map("condominium_id")
  runDate       DateTime         @map("run_date") @db.Date
  batchId       String?          @map("batch_id")
  status        BillingRunStatus
  detail        String?
  notifiedCount Int              @default(0) @map("notified_count")
  createdAt     DateTime         @default(now()) @map("created_at")

  condominium Condominium @relation(fields: [condominiumId], references: [id])

  @@index([condominiumId, runDate(sort: Desc)])
  @@map("billing_run_log")
}

model WaterTariffTier {
  id            String   @id @default(uuid())
  condominiumId String   @map("condominium_id")
  tierOrder     Int      @map("tier_order")
  upToM3        Decimal? @map("up_to_m3") @db.Decimal(10, 2)
  pricePerM3    Decimal  @map("price_per_m3") @db.Decimal(12, 2)

  condominium Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)

  @@unique([condominiumId, tierOrder])
  @@map("water_tariff_tiers")
}

model WaterReading {
  id              String   @id @default(uuid())
  propertyId      String   @map("property_id")
  period          DateTime @db.Date
  previousReading Decimal  @map("previous_reading") @db.Decimal(12, 2)
  currentReading  Decimal  @map("current_reading") @db.Decimal(12, 2)
  // consumptionM3 es GENERATED ALWAYS AS en Postgres (current - previous);
  // se calcula igual en la capa de servicio para no depender de leerlo
  // recién insertado. Ver src/lib/services/water.ts
  chargeId        String?  @unique @map("charge_id")
  createdById     String?  @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id])
  charge   Charge?  @relation(fields: [chargeId], references: [id])

  @@unique([propertyId, period])
  @@index([propertyId, period(sort: Desc)])
  @@map("water_readings")
}

// Catálogo global (no es tenant data) — sincronizado a diario contra
// el Banco Central de Costa Rica (indicadores 317/318).
model FxRate {
  rateDate DateTime @map("rate_date") @db.Date
  currency String   @default("USD")
  buyRate  Decimal  @map("buy_rate") @db.Decimal(10, 4)
  sellRate Decimal  @map("sell_rate") @db.Decimal(10, 4)
  source   String   @default("BCCR")
  syncedAt DateTime @default(now()) @map("synced_at")

  @@id([rateDate, currency])
  @@map("fx_rates")
}

// Historial de transiciones de suspensión (auditoría + evita
// duplicar notificaciones de una activación reciente).
model PropertyServiceSuspension {
  id               String    @id @default(uuid())
  propertyId       String    @map("property_id")
  monthsOverdue    Int       @map("months_overdue")
  startedAt        DateTime  @default(now()) @map("started_at")
  endedAt          DateTime? @map("ended_at") // NULL = vigente
  endedReason      String?   @map("ended_reason")
  residentNotified Boolean   @default(false) @map("resident_notified")

  property Property @relation(fields: [propertyId], references: [id])

  @@index([propertyId])
  @@map("property_service_suspensions")
}

